# Copy to .env and fill in. Never commit the filled file (.gitignore keeps it out).
# Every value below is a placeholder: example.com, documentation addresses (RFC 5737),
# private ranges. Replace them with yours.

# ── Which parts run ────────────────────────────────────────────────────────────
# Compose reads this list, so plain `docker compose ...` covers every part you added.
# Start with compose.yml and add the others in the order of docs/deploy.md.
COMPOSE_FILE=compose.yml
# COMPOSE_FILE=compose.yml:compose.trapdoor.yml:compose.headscale.yml:compose.crowdsec.yml:compose.traefik-manager.yml
# COMPOSE_FILE=...:compose.zerotier.yml          # optional third path

# ── You ────────────────────────────────────────────────────────────────────────
DOMAIN=example.com                 # services live at <name>.DOMAIN
PUBLIC_IP=203.0.113.10             # the cloud server's public address
TZ=UTC
CF_DNS_API_TOKEN=                  # DNS challenge for certificates (Cloudflare: Zone.DNS edit)

# ── The proxy network (Docker) ─────────────────────────────────────────────────
# One network for Traefik and everything it talks to. Fixed addresses for whatever a route,
# an allow-list or a trusted-proxy setting points at. Keep them here, in one place.
EDGE_SUBNET=172.30.0.0/24
IP_TRAEFIK=172.30.0.2
IP_TRAEFIK_MANAGER=172.30.0.20
IP_VPN_WG=172.30.0.30              # trapdoor's vpn container: WireGuard / OpenVPN
IP_TAILSCALE=172.30.0.40           # Tailscale node of the cloud server
IP_ZEROTIER=172.30.0.41            # ZeroTier member of the cloud server (optional)
IP_ADGUARD=172.30.0.53             # DNS for VPN clients

# ── VPN and tunnel ranges ──────────────────────────────────────────────────────
WG_SUBNET=10.8.10.0/24             # trapdoor WireGuard: your devices and the home server
OVPN_SUBNET=10.8.1.0/24            # trapdoor OpenVPN (optional)
TS_SUBNET=100.64.0.0/10            # Tailscale (Headscale's default range)
ZT_SUBNET=10.147.17.0/24           # ZeroTier (optional)
HOME_LAN=192.168.1.0/24            # behind the home server, reached through the tunnels
# Who counts as "on the VPN" for admin pages (Authelia rule, configurator, allow-lists):
VPN_CIDRS=10.8.10.0/24,10.8.1.0/24,100.64.0.0/10

# ── Authelia + configurator (see authelia-webui's production README) ───────────
AUTHELIA_VERSION=4.39.28           # also selects the configurator image tag
AUTHELIA_UID=1000                  # owner of ./authelia
AUTHELIA_GID=1000
DOCKER_GID=999                     # stat -c %g /var/run/docker.sock
ADMIN_GROUP=admin
APP_SECRET_KEY=                    # openssl rand -base64 48
REDIS_PASSWORD=                    # openssl rand -base64 32

# ── trapdoor ───────────────────────────────────────────────────────────────────
TD_IMAGE=ghcr.io/shuricksumy/trapdoor:0.4
TD_AGENT_TOKEN=                    # openssl rand -hex 32
WG_PORT=51820                      # UDP, open it in the cloud firewall
OVPN_PORT=1194                     # UDP, only if you run OpenVPN
TD_BACKUP_PASSPHRASE=              # encrypts trapdoor's scheduled backups

# ── Headscale / Tailscale ──────────────────────────────────────────────────────
HEADSCALE_VERSION=0.26.1
HEADPLANE_VERSION=0.6.1
TAILSCALE_VERSION=v1.84.0
TS_AUTHKEY=                        # from: docker compose exec headscale headscale preauthkeys create ...

# ── CrowdSec ───────────────────────────────────────────────────────────────────
CROWDSEC_BOUNCER_KEY=              # openssl rand -hex 32 (also in traefik/crowdsec-bouncer.key)

# ── ZeroTier (optional) ────────────────────────────────────────────────────────
ZTNET_POSTGRES_PASSWORD=           # openssl rand -hex 24
ZTNET_NEXTAUTH_SECRET=             # openssl rand -base64 32
